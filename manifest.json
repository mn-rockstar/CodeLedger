{
  "manifest_version": 3,
  "name": "CodeLedger",
  "version": "0.11.1",
  "description": "Auto-commits your Accepted LeetCode solutions to a GitHub repo you own.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content-leetcode.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*",
    "https://silver-elephant-7090.mn-rockstar.deno.net/*"
  ]
}
